# Copy to .env and fill in. .env is gitignored.

# Required for sustained use of `paperread discover`.
# Free signup: https://openalex.org/ (account settings → API key).
OPENALEX_API_KEY=

# Optional: override marker's auto-detected torch device (cuda / mps / cpu).
# TORCH_DEVICE=mps

# Optional: override default storage roots (used mainly by tests / CI).
# PAPERREAD_CACHE_DIR=/path/to/cache
# PAPERREAD_DATA_DIR=/path/to/data
